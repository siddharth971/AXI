{
  "name": "axi-server",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "scripts": {
    "dev": "nodemon app.js",
    "start": "node app.js",
    "train": "npm run axi:learn && node nlp/train.js",
    "generate:vectors": "node nlp/semantic/generate-vectors.js",
    "test": "node tests/axi-complete-test-suite.js",
    "axi:explore": "node autonomous/explorer.mjs",
    "axi:learn": "node nlp/learn.js",
    "axi:discover": "node autonomous/discover.js",
    "axi:extract": "node autonomous/extract.js",
    "axi:cycle": "npm run axi:discover && npm run axi:explore && npm run axi:extract && npm run axi:learn",
    "axi:expand": "node scripts/convert-expansion-batches.mjs --stats && node scripts/merge-intents.mjs",
    "train:expanded": "node nlp/train.js --intents=nlp/intents/combined_intents.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "axios": "^1.13.2",
    "brain.js": "^1.6.1",
    "compromise": "^14.14.5",
    "cors": "^2.8.5",
    "cosine-similarity": "^1.0.1",
    "express": "^5.1.0",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "screenshot-desktop": "^1.15.3",
    "socket.io": "^4.8.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
