      "page_content": {
        "hero_section": {
          "h1_title": "It's Not Just the Roof, It's the People Under It.",
          "h2_subtitle": "At Ranch Roofing, your roof is our top priority. We&#8217;ve spent over 30 years earning the trust of our neighbors, one roof at a time. We show up on time, treat every job with care, and stand behind every roof we install.",
          "cta_buttons": []
        },
        "value_props": [
          {
            "title": "Get a Free Estimate",
            "desc": "Description detected in content block."
          },
          {
            "title": "About Us",
