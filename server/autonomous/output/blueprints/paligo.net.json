        "hero_section": {
          "h1_title": "Structure is power.",
          "h2_subtitle": "Clear, consistent documentation is a growth lever. Organized at scale, it keeps every team aligned, every customer up to speed, and turns business-critical content into a strategic advantage",
          "cta_buttons": []
        },
        "value_props": [
