    "morphological_variations": {
      "description": "Generate legitimate word forms",
      "examples": {
        "commit": ["commits", "committed", "committing", "committer"],
        "deploy": [
          "deploys",
          "deployed",
          "deploying",
          "deployment",
          "deployable"
        ],
        "debug": ["debugs", "debugged", "debugging", "debugger", "debuggable"]
      }
    },
    "compound_terms": {
      "description": "Create domain-specific compound words",
      "examples": [
        "hot-reload",
        "fast-forward",
        "pull-request",
        "code-review",
        "auto-complete",
